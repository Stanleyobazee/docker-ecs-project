{
  "family": "academy-api",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "256",
  "memory": "512",
  "executionRoleArn": "arn:aws:iam::600627355607:role/ecsTaskExecutionRole",
  "containerDefinitions": [
    {
      "name": "academy-api",
      "image": "600627355607.dkr.ecr.eu-north-1.amazonaws.com/academy-api:1.5",
      "portMappings": [
        {
          "containerPort": 3000,
          "protocol": "tcp"
        }
      ],
      "environment": [
        {"name": "APP_VERSION", "value": "1.4.0"},
        {"name": "TARGET_GROUP", "value": "academy-tg"},
        {"name": "ENVIRONMENT", "value": "production"}
      ],
      "essential": true,
      "healthCheck": {
        "command": ["CMD-SHELL", "wget -qO- http://localhost:3000/health || exit 1"],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 10
      },
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/academy-api",
          "awslogs-region": "eu-north-1",
          "awslogs-stream-prefix": "ecs"
        }
      }
    }
  ]
}
